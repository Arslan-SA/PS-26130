# ==============================================================================
# UdyamSetu AI — Environment Configuration Template
# Copy this file to .env and adjust variables for your local/deployment setup.
# DO NOT COMMIT .env WITH REAL SECRETS.
# ==============================================================================

# Application Core
PROJECT_NAME="UdyamSetu AI"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Database
# Production: postgresql+asyncpg://postgres:postgres@localhost:5432/udyamsetu
# Local Development (Zero-Dependency fallback): sqlite+aiosqlite:///./udyamsetu.db
DATABASE_URL="sqlite+aiosqlite:///./udyamsetu.db"

# Security & Authentication
# Generate secure key using: openssl rand -hex 32
SECRET_KEY="insecure-hackathon-development-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated list or JSON array)
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# AI / LLM Configuration
# Options: "gemini", "mock", "openai"
AI_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
EMBEDDING_MODEL="text-embedding-004"

# Document Intelligence / OCR
# Options: "mock", "tesseract", "paddleocr"
OCR_ENGINE="mock"
TESSERACT_CMD=""

# Redis Cache / Background Workers
REDIS_URL="redis://localhost:6379/0"

# Document Object Storage
# Options: "local", "s3"
STORAGE_TYPE="local"
LOCAL_STORAGE_DIR="./uploads"
S3_BUCKET="udyamsetu-documents"
S3_ENDPOINT_URL=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
